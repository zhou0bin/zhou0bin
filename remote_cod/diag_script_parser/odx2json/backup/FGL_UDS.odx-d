            <PROTOCOL-SNREF SHORT-NAME="BCAN" />
          </COMPARAM-REF>
          <COMPARAM-REF ID-REF="ISO_15765_2.CP_CanFillerByteHandling" DOCREF="ISO_15765_2" DOCTYPE="COMPARAM-SUBSET">
            <SIMPLE-VALUE>Enabled</SIMPLE-VALUE>
            <DESC TI="1C8B02F67D4946ee8D330EAA3804273C">
              <p>Enables use of fill bytes; if &quot;true&quot;, fill bytes are used, otherwise DLC may be smaller than 8.</p>
            </DESC>
